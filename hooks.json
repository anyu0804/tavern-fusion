{
  "st-session-init": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/scripts/run_py.mjs\" \"${PLUGIN_ROOT}/hooks/session_init.py\"",
        "timeout": 10
      }
    ]
  },
  "st-pre-invocation-interceptor": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/scripts/run_py.mjs\" \"${PLUGIN_ROOT}/hooks/pre_invocation_gate.py\"",
        "timeout": 15
      }
    ]
  },
  "st-pre-tool-chokepoint": {
    "PreToolUse": [
      {
        "matcher": "(^|.*[-_.:/])st_[a-z_]+$|write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/run_py.mjs\" \"${PLUGIN_ROOT}/hooks/pre_tool_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "st-stop-sync-guarantor": {
    "Stop": [
      {
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/scripts/run_py.mjs\" \"${PLUGIN_ROOT}/hooks/stop_persistence_check.py\"",
        "timeout": 10
      }
    ]
  }
}
